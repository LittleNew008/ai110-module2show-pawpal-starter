classDiagram
    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
        +from_str(value) Priority
    }

    class Category {
        <<enumeration>>
        WALK
        FEEDING
        MEDS
        ENRICHMENT
        GROOMING
        OTHER
    }

    class Recurrence {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    %% Owner availability: the day_start-day_end window is the source of truth;
    %% available_minutes is an optional extra cap (scheduler uses the tighter limit).
    class Owner {
        +str name
        +time day_start
        +time day_end
        +int available_minutes
        +dict preferred_times
        +list~Pet~ pets
        +add_pet(pet) None
        +remove_pet(pet_id) None
        +set_availability(start, end, available_minutes) None
        +capacity_minutes() int
        +get_all_tasks() list~PetTask~
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age
        +str special_needs
        +list~Task~ tasks
        +str id
        +add_task(task) None
        +edit_task(task_id, **changes) None
        +remove_task(task_id) None
        +get_tasks() list~Task~
    }

    %% last_completed + start_date replace a single completed flag, which cannot work for recurring tasks.
    class Task {
        +str title
        +int duration_minutes
        +Priority priority
        +Category category
        +time preferred_start
        +time fixed_time
        +Recurrence recurrence
        +bool required
        +str description
        +date start_date
        +date last_completed
        +str id
        +is_due(on) bool
        +is_completed(on) bool
        +mark_complete(on) None
    }

    %% A task does not point back to its pet; PetTask carries the pair.
    class PetTask {
        +Pet pet
        +Task task
    }

    class Scheduler {
        +Owner owner
        +generate_plan(on) DailyPlan
        +filter_due_tasks(on) list~PetTask~
        +sort_tasks(tasks) list~PetTask~
        +fit_to_available_time(tasks) scheduled and skipped lists
        +detect_conflicts(items) list of overlapping pairs
    }

    class DailyPlan {
        +date on
        +list~ScheduledItem~ scheduled_items
        +list~SkippedTask~ skipped_tasks
        +list~str~ warnings
        +total_minutes() int
        +flagged_tasks() list~SkippedTask~
        +summary() str
        +explain() str
        +to_table() list~dict~
    }

    class ScheduledItem {
        +Task task
        +Pet pet
        +time start
        +time end
        +str reason
        +duration() int
        +overlaps(other) bool
    }

    class SkippedTask {
        +Task task
        +Pet pet
        +str reason
        +bool flagged
    }

    Owner "1" --> "*" Pet : has
    Owner ..> Category : preferred_times
    Owner ..> PetTask : get_all_tasks
    Pet "1" --> "*" Task : needs
    Task --> Priority
    Task --> Category
    Task --> Recurrence
    PetTask --> Pet
    PetTask --> Task
    Scheduler --> Owner : plans for
    Scheduler ..> PetTask : reads via Owner.get_all_tasks
    Scheduler ..> DailyPlan : creates
    DailyPlan "1" --> "*" ScheduledItem : contains
    DailyPlan "1" --> "*" SkippedTask : contains
    ScheduledItem --> Task
    ScheduledItem --> Pet
    SkippedTask --> Task
    SkippedTask --> Pet
